# RV Market Intelligence — Environment variables
# Copy this file to .env and fill your FREE API key.

# ── Option 1 (RECOMMENDED, FREE): Groq ─────────────────────────
# 1. Go to https://console.groq.com  → sign in (Google/GitHub)
# 2. API Keys → Create API Key → copy it here:
GROQ_API_KEY=

# Optional: model override (default: openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# ── Option 2: xAI Grok API (paid) ──────────────────────────────
# XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=grok-4-fast

# You can also paste the key directly in the web UI (Settings ⚙).
# The key NEVER leaves your machine — it is only sent to the
# LLM provider you choose (Groq / xAI / custom).
